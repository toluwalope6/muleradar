# Data source: "live" (MuleRadar backend API, default) or "mock" (bundled synthetic demo cases).
# Can be overridden per page load with ?source=live or ?source=mock.
VITE_DATA_SOURCE=live
# Base URL for API requests. The default "/api" goes through the Vite dev/preview proxy.
VITE_API_BASE_URL=/api
# Proxy target used by `npm run dev` / `npm run preview` (read by vite.config.ts, not sent to the browser).
MULERADAR_API_URL=http://127.0.0.1:8000
